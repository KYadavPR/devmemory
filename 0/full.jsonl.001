{"parentUuid":"083b50eb-0186-435c-855b-fbbfec617a65","isSidechain":false,"promptId":"5bbddbb1-bc91-43d1-9778-b85a5f814549","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VGG5nfG6kCp1gZbyvR2eUU","type":"tool_result","content":"The file d:\\Hackathons\\TechWeek\\pyproject.toml has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"uuid":"6c6d6c5d-8b88-44cf-8b2e-65bd1daa86ae","timestamp":"2026-09-07T21:24:32.046Z","toolUseResult":{"filePath":"d:\\Hackathons\\TechWeek\\pyproject.toml","oldString":"    \"src/devmemory\",\n    \"docs\",\n    \"examples\",\n    \"tests\",\n    \"README.md\",\n    \"CHANGELOG.md\",\n    \"DEMO.md\",\n    \"LICENSE\",\n]","newString":"    \"src/devmemory\",\n    \"docs\",\n    \"tests\",\n    \"README.md\",\n    \"CHANGELOG.md\",\n    \"LICENSE\",\n]","originalFile":"[build-system]\nrequires = [\"hatchling\"]\nbuild-backend = \"hatchling.build\"\n\n[project]\nname = \"devmemory-cli\"\ndynamic = [\"version\"]\ndescription = \"Development-memory and version-intelligence for AI-assisted software development\"\nreadme = \"README.md\"\nrequires-python = \">=3.11\"\nlicense = \"MIT\"\nlicense-files = [\"LICENSE\"]\nauthors = [{ name = \"DevMemory contributors\" }]\nkeywords = [\n    \"ai\",\n    \"git\",\n    \"entire\",\n    \"checkpoint\",\n    \"development-memory\",\n    \"version-intelligence\",\n    \"mcp\",\n    \"databricks\",\n]\nclassifiers = [\n    \"Development Status :: 3 - Alpha\",\n    \"Environment :: Console\",\n    \"Intended Audience :: Developers\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Programming Language :: Python :: 3.11\",\n    \"Programming Language :: Python :: 3.12\",\n    \"Programming Language :: Python :: 3.13\",\n    \"Programming Language :: Python :: 3.14\",\n    \"Topic :: Software Development :: Version Control :: Git\",\n    \"Topic :: Software Development :: Quality Assurance\",\n]\ndependencies = [\n    \"typer>=0.12\",\n    \"rich>=13.7\",\n    \"pydantic>=2.7\",\n    \"structlog>=24.1\",\n    \"platformdirs>=4.2\",\n    \"python-dotenv>=1.0\",\n    \"fastapi>=0.111\",\n    \"uvicorn[standard]>=0.30\",\n    \"jinja2>=3.1\",\n]\n\n[project.optional-dependencies]\nmcp = [\"fastmcp>=2.3\"]\ndatabricks = [\"databricks-sdk>=0.30\"]\nllm = [\n    \"anthropic>=0.40\",\n    \"openai>=1.40\",\n    \"google-genai>=0.3\",\n]\nlocal-llm = [\"llama-cpp-python>=0.3.2\"]\nall = [\"devmemory-cli[mcp,databricks,llm,local-llm]\"]\ndev = [\n    \"devmemory-cli[mcp,databricks,llm]\",\n    \"pytest>=8.2\",\n    \"pytest-cov>=5.0\",\n    \"pytest-xdist>=3.6\",\n    \"ruff>=0.5\",\n    \"mypy>=1.10\",\n]\n\n[project.urls]\nDocumentation = \"https://github.com/KYadavPR/devmemory\"\nSource = \"https://github.com/KYadavPR/devmemory\"\n\n[project.scripts]\ndevmemory = \"devmemory.cli.app:main\"\ndm = \"devmemory.cli.app:main\"\n\n[tool.hatch.version]\npath = \"src/devmemory/__about__.py\"\n\n[tool.hatch.build.targets.wheel]\npackages = [\"src/devmemory\"]\n# Ship the built dashboard bundle (src/devmemory/web/static/); never the Vite\n# source tree or its node deps.\nexclude = [\"src/devmemory/web/frontend\"]\n\n[tool.hatch.build.targets.sdist]\ninclude = [\n    \"src/devmemory\",\n    \"docs\",\n    \"examples\",\n    \"tests\",\n    \"README.md\",\n    \"CHANGELOG.md\",\n    \"DEMO.md\",\n    \"LICENSE\",\n]\nexclude = [\n    \"src/devmemory/web/frontend/node_modules\",\n    \"src/devmemory/web/frontend/.vite\",\n]\n\n[tool.ruff]\nline-length = 100\ntarget-version = \"py311\"\nsrc = [\"src\", \"tests\"]\nextend-exclude = [\"docs\", \"examples\", \"src/devmemory/web/frontend\"]\n\n[tool.ruff.lint]\nselect = [\n    \"E\",    # pycodestyle errors\n    \"W\",    # pycodestyle warnings\n    \"F\",    # pyflakes\n    \"I\",    # isort\n    \"N\",    # pep8-naming\n    \"UP\",   # pyupgrade\n    \"B\",    # flake8-bugbear\n    \"C4\",   # flake8-comprehensions\n    \"SIM\",  # flake8-simplify\n    \"PTH\",  # flake8-use-pathlib\n    \"TID\",  # flake8-tidy-imports\n    \"S\",    # flake8-bandit\n    \"SLF\",  # flake8-self\n    \"RUF\",  # ruff-specific\n]\nignore = [\n    \"E501\",  # line length is enforced by the formatter\n]\n\n[tool.ruff.lint.isort]\nknown-first-party = [\"devmemory\"]\n\n[tool.ruff.lint.flake8-tidy-imports]\nban-relative-imports = \"all\"\n\n[tool.ruff.lint.per-file-ignores]\n\"tests/**\" = [\"S101\", \"S105\", \"S106\", \"S603\", \"S607\", \"SLF001\"]\n# Table names are interpolated from trusted project config (catalog/schema),\n# every value is a bound `:param`. There is no user SQL surface here.\n\"src/devmemory/adapters/databricks.py\" = [\"S608\"]\n\"src/devmemory/services/analytics.py\" = [\"S608\"]\n\n[tool.mypy]\npython_version = \"3.11\"\nstrict = true\nfiles = [\"src/devmemory\"]\nplugins = [\"pydantic.mypy\"]\nwarn_unreachable = true\nwarn_no_return = true\nshow_error_codes = true\nenable_error_code = [\"redundant-expr\", \"truthy-bool\", \"ignore-without-code\"]\n\n[[tool.mypy.overrides]]\nmodule = [\"fastmcp.*\", \"databricks.*\", \"google.genai.*\", \"llama_cpp.*\"]\nignore_missing_imports = true\n\n# numpy arrives transitively with the optional `local-llm` extra; its stubs use\n# 3.12+ syntax that trips mypy pinned at 3.11. We never import it directly.\n[[tool.mypy.overrides]]\nmodule = [\"numpy\", \"numpy.*\"]\nignore_missing_imports = true\nfollow_imports = \"skip\"\nfollow_imports_for_stubs = true\n\n[tool.pytest.ini_options]\nminversion = \"8.0\"\naddopts = \"-ra -q --strict-markers --strict-config\"\ntestpaths = [\"tests\"]\nmarkers = [\n    \"integration: tests that shell out to git/entire or touch the network\",\n    \"slow: long-running tests\",\n]\nfilterwarnings = [\n    \"error\",\n    \"ignore::DeprecationWarning:starlette.*\",\n    \"ignore::DeprecationWarning:anyio.*\",\n]\n\n[tool.coverage.run]\nsource = [\"devmemory\"]\nbranch = true\n\n[tool.coverage.report]\nexclude_also = [\n    \"if TYPE_CHECKING:\",\n    \"raise NotImplementedError\",\n    \"@(abc\\\\.)?abstractmethod\",\n]\n","structuredPatch":[{"oldStart":86,"oldLines":11,"newStart":86,"newLines":9,"lines":[" include = [","     \"src/devmemory\",","     \"docs\",","-    \"examples\",","     \"tests\",","     \"README.md\",","     \"CHANGELOG.md\",","-    \"DEMO.md\",","     \"LICENSE\","," ]"," exclude = ["]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"083b50eb-0186-435c-855b-fbbfec617a65","userType":"external","entrypoint":"claude-vscode","cwd":"D:\\Hackathons\\TechWeek","sessionId":"fcec3b82-fe78-4cb6-b1dc-40e4f8a72893","version":"2.1.263","gitBranch":"docs/project-details","slug":"buzzing-baking-crystal"}
