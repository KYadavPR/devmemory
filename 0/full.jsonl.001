{"parentUuid":"66cfcc95-5080-4f63-b0ce-c6cc2417d980","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"D:\\Hackathons\\TechWeek\\src\\devmemory\\web\\frontend\\src\\routes\\Ask.tsx","snippet":"1\timport { useEffect, useRef, useState } from \"react\";\n2\timport { useMutation } from \"@tanstack/react-query\";\n3\timport { useGenieStatus, askGenie } from \"@/api/client\";\n4\timport { Card, PageHead, EmptyState } from \"@/components/primitives\";\n5\timport { Icon } from \"@/components/Icon\";\n6\timport { motion, AnimatePresence, useReducedMotion, spring, ThinkingDots } from \"@/lib/motion\";\n7\timport type { GenieAnswer } from \"@/api/types\";\n8\t\n9\ttype Turn =\n10\t  | { role: \"user\"; text: string }\n11\t  | { role: \"genie\"; answer: GenieAnswer }\n12\t  | { role: \"error\"; text: string };\n13\t\n14\tconst SUGGESTIONS = [\n15\t  \"Which features regressed the most?\",\n16\t  \"Show every version that failed tests, newest first\",\n17\t  \"What files change together most often?\",\n18\t  \"How did quote_latency_ms move over time?\",\n19\t];\n20\t\n21\tfunction errorDetail(message: string): string {\n22\t  try {\n23\t    const parsed = JSON.parse(message);\n24\t    if (parsed && typeof parsed.detail === \"string\") return parsed.detail;\n25\t  } catch {\n26\t    /* not json */\n27\t  }\n28\t  return message;\n29\t}\n30\t\n31\texport function Ask() {\n32\t  const reduce = useReducedMotion();\n33\t  const status = useGenieStatus();\n34\t  const [turns, setTurns] = useState<Turn[]>([]);\n35\t  const [draft, setDraft] = useState(\"\");\n36\t  const [conversationId, setConversationId] = useState<string | null>(null);\n37\t  const scrollerRef = useRef<HTMLDivElement>(null);\n38\t\n39\t  const ask = useMutation({\n40\t    mutationFn: (q: string) => askGenie(q, conversationId),\n41\t    onSuccess: (answer) => {\n42\t      if (answer.conversation_id) setConversationId(answer.conversation_id);\n43\t      setTurns((t) => [...t, { role: \"genie\", answer }]);\n44\t    },\n45\t    onError: (err: Error) => {\n46\t      setTurns((t) => [...t, { role: \"error\", text: errorDetail(err.message) }]);\n47\t    },\n48\t  });\n49\t\n50\t  useEffect(() => {\n51\t    scrollerRef.current?.scrollTo({ top: scrollerRef.current.scrollHeight, behavior: \"smooth\" });\n52\t  }, [turns, ask.isPending]);\n53\t\n54\t  const send = (q: string) => {\n55\t    const question = q.trim();\n56\t    if (!question || ask.isPending) return;\n57\t    setTurns((t) => [...t, { role: \"user\", text: question }]);\n58\t    setDraft(\"\");\n59\t    ask.mutate(question);\n60\t  };\n61\t\n62\t  const newChat = () => {\n63\t    setTurns([]);\n64\t    setConversationId(null);\n65\t  };\n66\t\n67\t  return (\n68\t    <>\n69\t      <PageHead\n70\t        title=\"Ask\"\n71\t        subtitle=\"Natural-language questions over your development history, answered by Databricks Genie against the devmemory.analytics tables.\"\n72\t        actions={\n73\t          turns.length > 0 ? (\n74\t            <button className=\"btn\" onClick={newChat}>\n75\t              <Icon name=\"plus\" size={14} /> New chat\n76\t            </button>\n77\t          ) : undefined\n78\t        }\n79\t      />\n80\t\n81\t      {status.data && !status.data.configured ? (\n82\t        <Card title=\"Genie is not configured\" pad>\n83\t          <p className=\"text-sm\">{status.data.reason}</p>\n84\t          <p className=\"muted text-sm\">\n85\t            Set a Genie space that reads the <code>devmemory.analytics</code> schema, then point\n86\t            DevMemory at it:\n87\t          </p>\n88\t          <pre className=\"loop-prompt\">{`# .devmemory/config.json\n89\t\"databricks\": { \"enabled\": true, \"genie_space_id\": \"01ef...\" }\n90\t\n91\t# or the environment\n92\tDATABRICKS_HOST=...       DATABRICKS_TOKEN=...\n93\tDATABRICKS_GENIE_SPACE_ID=01ef...`}</pre>\n94\t          <p className=\"muted text-xs\">\n95\t            Run <code>devmemory databricks sync</code> first so the tables have data for Genie to\n96\t            query.\n97\t          </p>\n98\t        </Card>\n99\t      ) : (\n100\t        <Card flush>\n101\t          <div className=\"chat\" ref={scrollerRef}>\n102\t            {turns.length === 0 && (\n103\t              <div className=\"chat__empty\">\n104\t                <EmptyState\n105\t                  icon=\"sparkles\"\n106\t                  title=\"Ask about your project\"\n107\t                  sub=\"Genie writes the SQL, runs it on Databricks, and explains the result.\"\n108\t                />\n109\t                <div className=\"chat__suggest\">\n110\t                  {SUGGESTIONS.map((s) => (\n111\t                    <button key={s} className=\"chip\" onClick={() => send(s)}>\n112\t                      {s}\n113\t                    </button>\n114\t                  ))}\n115\t                </div>\n116\t              </div>\n117\t            )}\n118\t\n119\t            <AnimatePresence initial={false}>\n120\t              {turns.map((turn, i) => (\n121\t                <m.div\n122\t                  key={i}\n123\t                  layout={!reduce}\n124\t                  initial={reduce ? false : { opacity: 0, y: 10 }}\n125\t                  animate={{ opacity: 1, y: 0 }}\n126\t                  transition={spring.gentle}\n127\t                >\n128\t                  <TurnView turn={turn} />\n129\t                </m.div>\n130\t              ))}\n131\t            </AnimatePresence>\n132\t\n133\t            {ask.isPending && (\n134\t              <m.div\n135\t                className=\"chat__msg chat__msg--genie\"\n136\t                initial={reduce ? false : { opacity: 0, y: 8 }}\n137\t                animate={{ opacity: 1, y: 0 }}\n138\t                transition={spring.gentle}\n139\t              >\n140\t                <div className=\"chat__role\">Genie</div>\n141\t                <div className=\"chat__body row\" style={{ gap: 8, color: \"var(--text-muted)\" }}>\n142\t                  <ThinkingDots /> thinking…\n143\t                </div>\n144\t              </m.div>\n145\t            )}\n146\t          </div>\n147\t\n148\t          <form\n149\t            className=\"chat__input\"\n150\t            onSubmit={(e) => {\n151\t              e.preventDefault();\n152\t              send(draft);\n153\t            }}\n154\t          >\n155\t            <input\n156\t              className=\"input\"\n157\t              placeholder=\"Ask a question about this project…\"\n158\t              value={draft}\n159\t              onChange={(e) => setDraft(e.target.value)}\n160\t              disabled={ask.isPending || !status.data?.configured}\n161\t            />\n162\t            <button\n163\t              className=\"btn btn--primary\"\n164\t              type=\"submit\"\n165\t              disabled={ask.isPending || !draft.trim() || !status.data?.configured}\n166\t            >\n167\t              <Icon name=\"arrowRight\" size={15} />\n168\t            </button>\n169\t          </form>\n170\t        </Card>\n171\t      )}\n172\t    </>\n173\t  );\n174\t}\n175\t\n176\tfunction TurnView({ turn }: { turn: Turn }) {\n177\t  if (turn.role === \"user\") {\n178\t    return (\n179\t      <div className=\"chat__msg chat__msg--user\">\n180\t        <div className=\"chat__body\">{turn.text}</div>\n181\t      </div>\n182\t    );\n183\t  }\n184\t  if (turn.role === \"error\") {\n185\t    return (\n186\t      <div className=\"chat__msg chat__msg--genie\">\n187\t        <div className=\"chat__role\">Genie</div>\n188\t        <div className=\"chat__body callout callout--bad\" style={{ padding: \"8px 10px\" }}>\n189\t          <Icon name=\"alert\" size={13} /> {turn.text}\n190\t        </div>\n191\t      </div>\n192\t    );\n193\t  }\n194\t\n195\t  const a = turn.answer;\n196\t  return (\n197\t    <div className=\"chat__msg chat__msg--genie\">\n198\t      <div className=\"chat__role\">Genie</div>\n199\t      <div className=\"chat__body stack\" style={{ gap: 10 }}>\n200\t        {a.error && (\n201\t          <div className=\"callout callout--bad\" style={{ padding: \"8px 10px\" }}>\n202\t            <Icon name=\"alert\" size={13} /> {a.error}\n203\t          </div>\n204\t        )}\n205\t        {a.text && <div style={{ whiteSpace: \"pre-wrap\" }}>{a.text}</div>}\n206\t        {a.rows.length > 0 && <ResultTable columns={a.columns} rows={a.rows} />}\n207\t        {(a.row_count != null || a.truncated) && (\n208\t          <div className=\"muted text-xs\">\n209\t            {a.row_count ?? a.rows.length} row{(a.row_count ?? a.rows.length) === 1 ? \"\" : \"s\"}\n210\t            {a.truncated && ` · showing first ${a.rows.length}`}\n211\t          </div>\n212\t        )}\n213\t        {a.sql && (\n214\t          <details className=\"chat__sql\">\n215\t            <summary>SQL</summary>\n216\t            <pre className=\"loop-prompt\">{a.sql}</pre>\n217\t          </details>\n218\t        )}\n\n... [34 lines truncated] ..."},"type":"attachment","uuid":"81346377-7b72-4605-96ba-04075dd98845","timestamp":"2026-09-07T14:33:11.924Z","rendered":[{"content":"<system-reminder>\nNote: D:\\Hackathons\\TechWeek\\src\\devmemory\\web\\frontend\\src\\routes\\Ask.tsx changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n1\timport { useEffect, useRef, useState } from \"react\";\n2\timport { useMutation } from \"@tanstack/react-query\";\n3\timport { useGenieStatus, askGenie } from \"@/api/client\";\n4\timport { Card, PageHead, EmptyState } from \"@/components/primitives\";\n5\timport { Icon } from \"@/components/Icon\";\n6\timport { motion, AnimatePresence, useReducedMotion, spring, ThinkingDots } from \"@/lib/motion\";\n7\timport type { GenieAnswer } from \"@/api/types\";\n8\t\n9\ttype Turn =\n10\t  | { role: \"user\"; text: string }\n11\t  | { role: \"genie\"; answer: GenieAnswer }\n12\t  | { role: \"error\"; text: string };\n13\t\n14\tconst SUGGESTIONS = [\n15\t  \"Which features regressed the most?\",\n16\t  \"Show every version that failed tests, newest first\",\n17\t  \"What files change together most often?\",\n18\t  \"How did quote_latency_ms move over time?\",\n19\t];\n20\t\n21\tfunction errorDetail(message: string): string {\n22\t  try {\n23\t    const parsed = JSON.parse(message);\n24\t    if (parsed && typeof parsed.detail === \"string\") return parsed.detail;\n25\t  } catch {\n26\t    /* not json */\n27\t  }\n28\t  return message;\n29\t}\n30\t\n31\texport function Ask() {\n32\t  const reduce = useReducedMotion();\n33\t  const status = useGenieStatus();\n34\t  const [turns, setTurns] = useState<Turn[]>([]);\n35\t  const [draft, setDraft] = useState(\"\");\n36\t  const [conversationId, setConversationId] = useState<string | null>(null);\n37\t  const scrollerRef = useRef<HTMLDivElement>(null);\n38\t\n39\t  const ask = useMutation({\n40\t    mutationFn: (q: string) => askGenie(q, conversationId),\n41\t    onSuccess: (answer) => {\n42\t      if (answer.conversation_id) setConversationId(answer.conversation_id);\n43\t      setTurns((t) => [...t, { role: \"genie\", answer }]);\n44\t    },\n45\t    onError: (err: Error) => {\n46\t      setTurns((t) => [...t, { role: \"error\", text: errorDetail(err.message) }]);\n47\t    },\n48\t  });\n49\t\n50\t  useEffect(() => {\n51\t    scrollerRef.current?.scrollTo({ top: scrollerRef.current.scrollHeight, behavior: \"smooth\" });\n52\t  }, [turns, ask.isPending]);\n53\t\n54\t  const send = (q: string) => {\n55\t    const question = q.trim();\n56\t    if (!question || ask.isPending) return;\n57\t    setTurns((t) => [...t, { role: \"user\", text: question }]);\n58\t    setDraft(\"\");\n59\t    ask.mutate(question);\n60\t  };\n61\t\n62\t  const newChat = () => {\n63\t    setTurns([]);\n64\t    setConversationId(null);\n65\t  };\n66\t\n67\t  return (\n68\t    <>\n69\t      <PageHead\n70\t        title=\"Ask\"\n71\t        subtitle=\"Natural-language questions over your development history, answered by Databricks Genie against the devmemory.analytics tables.\"\n72\t        actions={\n73\t          turns.length > 0 ? (\n74\t            <button className=\"btn\" onClick={newChat}>\n75\t              <Icon name=\"plus\" size={14} /> New chat\n76\t            </button>\n77\t          ) : undefined\n78\t        }\n79\t      />\n80\t\n81\t      {status.data && !status.data.configured ? (\n82\t        <Card title=\"Genie is not configured\" pad>\n83\t          <p className=\"text-sm\">{status.data.reason}</p>\n84\t          <p className=\"muted text-sm\">\n85\t            Set a Genie space that reads the <code>devmemory.analytics</code> schema, then point\n86\t            DevMemory at it:\n87\t          </p>\n88\t          <pre className=\"loop-prompt\">{`# .devmemory/config.json\n89\t\"databricks\": { \"enabled\": true, \"genie_space_id\": \"01ef...\" }\n90\t\n91\t# or the environment\n92\tDATABRICKS_HOST=...       DATABRICKS_TOKEN=...\n93\tDATABRICKS_GENIE_SPACE_ID=01ef...`}</pre>\n94\t          <p className=\"muted text-xs\">\n95\t            Run <code>devmemory databricks sync</code> first so the tables have data for Genie to\n96\t            query.\n97\t          </p>\n98\t        </Card>\n99\t      ) : (\n100\t        <Card flush>\n101\t          <div className=\"chat\" ref={scrollerRef}>\n102\t            {turns.length === 0 && (\n103\t              <div className=\"chat__empty\">\n104\t                <EmptyState\n105\t                  icon=\"sparkles\"\n106\t                  title=\"Ask about your project\"\n107\t                  sub=\"Genie writes the SQL, runs it on Databricks, and explains the result.\"\n108\t                />\n109\t                <div className=\"chat__suggest\">\n110\t                  {SUGGESTIONS.map((s) => (\n111\t                    <button key={s} className=\"chip\" onClick={() => send(s)}>\n112\t                      {s}\n113\t                    </button>\n114\t                  ))}\n115\t                </div>\n116\t              </div>\n117\t            )}\n118\t\n119\t            <AnimatePresence initial={false}>\n120\t              {turns.map((turn, i) => (\n121\t                <m.div\n122\t                  key={i}\n123\t                  layout={!reduce}\n124\t                  initial={reduce ? false : { opacity: 0, y: 10 }}\n125\t                  animate={{ opacity: 1, y: 0 }}\n126\t                  transition={spring.gentle}\n127\t                >\n128\t                  <TurnView turn={turn} />\n129\t                </m.div>\n130\t              ))}\n131\t            </AnimatePresence>\n132\t\n133\t            {ask.isPending && (\n134\t              <m.div\n135\t                className=\"chat__msg chat__msg--genie\"\n136\t                initial={reduce ? false : { opacity: 0, y: 8 }}\n137\t                animate={{ opacity: 1, y: 0 }}\n138\t                transition={spring.gentle}\n139\t              >\n140\t                <div className=\"chat__role\">Genie</div>\n141\t                <div className=\"chat__body row\" style={{ gap: 8, color: \"var(--text-muted)\" }}>\n142\t                  <ThinkingDots /> thinking…\n143\t                </div>\n144\t              </m.div>\n145\t            )}\n146\t          </div>\n147\t\n148\t          <form\n149\t            className=\"chat__input\"\n150\t            onSubmit={(e) => {\n151\t              e.preventDefault();\n152\t              send(draft);\n153\t            }}\n154\t          >\n155\t            <input\n156\t              className=\"input\"\n157\t              placeholder=\"Ask a question about this project…\"\n158\t              value={draft}\n159\t              onChange={(e) => setDraft(e.target.value)}\n160\t              disabled={ask.isPending || !status.data?.configured}\n161\t            />\n162\t            <button\n163\t              className=\"btn btn--primary\"\n164\t              type=\"submit\"\n165\t              disabled={ask.isPending || !draft.trim() || !status.data?.configured}\n166\t            >\n167\t              <Icon name=\"arrowRight\" size={15} />\n168\t            </button>\n169\t          </form>\n170\t        </Card>\n171\t      )}\n172\t    </>\n173\t  );\n174\t}\n175\t\n176\tfunction TurnView({ turn }: { turn: Turn }) {\n177\t  if (turn.role === \"user\") {\n178\t    return (\n179\t      <div className=\"chat__msg chat__msg--user\">\n180\t        <div className=\"chat__body\">{turn.text}</div>\n181\t      </div>\n182\t    );\n183\t  }\n184\t  if (turn.role === \"error\") {\n185\t    return (\n186\t      <div className=\"chat__msg chat__msg--genie\">\n187\t        <div className=\"chat__role\">Genie</div>\n188\t        <div className=\"chat__body callout callout--bad\" style={{ padding: \"8px 10px\" }}>\n189\t          <Icon name=\"alert\" size={13} /> {turn.text}\n190\t        </div>\n191\t      </div>\n192\t    );\n193\t  }\n194\t\n195\t  const a = turn.answer;\n196\t  return (\n197\t    <div className=\"chat__msg chat__msg--genie\">\n198\t      <div className=\"chat__role\">Genie</div>\n199\t      <div className=\"chat__body stack\" style={{ gap: 10 }}>\n200\t        {a.error && (\n201\t          <div className=\"callout callout--bad\" style={{ padding: \"8px 10px\" }}>\n202\t            <Icon name=\"alert\" size={13} /> {a.error}\n203\t          </div>\n204\t        )}\n205\t        {a.text && <div style={{ whiteSpace: \"pre-wrap\" }}>{a.text}</div>}\n206\t        {a.rows.length > 0 && <ResultTable columns={a.columns} rows={a.rows} />}\n207\t        {(a.row_count != null || a.truncated) && (\n208\t          <div className=\"muted text-xs\">\n209\t            {a.row_count ?? a.rows.length} row{(a.row_count ?? a.rows.length) === 1 ? \"\" : \"s\"}\n210\t            {a.truncated && ` · showing first ${a.rows.length}`}\n211\t          </div>\n212\t        )}\n213\t        {a.sql && (\n214\t          <details className=\"chat__sql\">\n215\t            <summary>SQL</summary>\n216\t            <pre className=\"loop-prompt\">{a.sql}</pre>\n217\t          </details>\n218\t        )}\n\n... [34 lines truncated] ...\n</system-reminder>"}],"userType":"external","entrypoint":"claude-vscode","cwd":"d:\\Hackathons\\TechWeek","sessionId":"fcec3b82-fe78-4cb6-b1dc-40e4f8a72893","version":"2.1.263","gitBranch":"docs/project-details","slug":"buzzing-baking-crystal"}
{"parentUuid":"81346377-7b72-4605-96ba-04075dd98845","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"D:\\Hackathons\\TechWeek\\src\\devmemory\\web\\frontend\\src\\routes\\TaskDetail.tsx","snippet":"1\timport { useEffect, useRef, useState } from \"react\";\n2\timport { useParams } from \"react-router-dom\";\n3\timport { useMutation, useQueryClient } from \"@tanstack/react-query\";\n4\timport {\n5\t  useTaskState,\n6\t  useTaskSnapshots,\n7\t  refreshTask,\n8\t  completeTask,\n9\t  reportIssue,\n10\t  resolveIssue,\n11\t  setRequirement,\n12\t} from \"@/api/client\";\n13\timport { Async } from \"@/components/Async\";\n14\timport { Badge, Card, PageHead, StatTile } from \"@/components/primitives\";\n15\timport { Icon } from \"@/components/Icon\";\n16\timport { statusTone, statusLabel, type Tone } from \"@/lib/status\";\n17\timport { shortSha, relativeTime } from \"@/lib/format\";\n18\timport {\n19\t  motion,\n20\t  AnimatePresence,\n21\t  useReducedMotion,\n22\t  spring,\n23\t  Pressable,\n24\t  DrawCheck,\n25\t} from \"@/lib/motion\";\n26\timport type { NormalizedState, RequirementStatus, SnapshotSummary } from \"@/api/types\";\n27\t\n28\tconst REQ_CYCLE: RequirementStatus[] = [\"INCOMPLETE\", \"PARTIAL\", \"COMPLETE\"];\n29\t\n30\texport function TaskDetail() {\n31\t  const { id } = useParams<{ id: string }>();\n32\t  const qc = useQueryClient();\n33\t  const state = useTaskState(id);\n34\t  const snapshots = useTaskSnapshots(id);\n35\t\n36\t  const apply = (data: NormalizedState) => {\n37\t    qc.setQueryData([\"task-state\", id], data);\n38\t    qc.invalidateQueries({ queryKey: [\"task-snapshots\", id] });\n39\t    qc.invalidateQueries({ queryKey: [\"tasks\"] });\n40\t  };\n41\t\n42\t  const refresh = useMutation({ mutationFn: () => refreshTask(id!), onSuccess: apply });\n43\t  const complete = useMutation({ mutationFn: () => completeTask(id!), onSuccess: apply });\n44\t  const setReq = useMutation({\n45\t    mutationFn: (v: { req: string; status: string }) => setRequirement(id!, v.req, v.status, \"set from dashboard\"),\n46\t    onSuccess: apply,\n47\t  });\n48\t  const addIssue = useMutation({\n49\t    mutationFn: (v: { description: string; blocking: boolean }) => reportIssue(id!, v.description, v.blocking),\n50\t    onSuccess: apply,\n51\t  });\n52\t  const dropIssue = useMutation({\n53\t    mutationFn: (issueId: number) => resolveIssue(id!, issueId),\n54\t    onSuccess: apply,\n55\t  });\n56\t\n57\t  const busy =\n58\t    refresh.isPending ||\n59\t    complete.isPending ||\n60\t    setReq.isPending ||\n61\t    addIssue.isPending ||\n62\t    dropIssue.isPending;\n63\t\n64\t  // --- auto-loop: keep refreshing and suggesting the next prompt -----------\n65\t  const LOOP_MS = 9000;\n66\t  const isTerminal = (st?: string) => st === \"READY\" || st === \"BLOCKED\";\n67\t  const [auto, setAuto] = useState(() => {\n68\t    try {\n69\t      return localStorage.getItem(`loop-auto:${id}`) === \"1\";\n70\t    } catch {\n71\t      return false;\n72\t    }\n73\t  });\n74\t  const [guardTrip, setGuardTrip] = useState<string | null>(null);\n75\t  const prevFindings = useRef<number | null>(null);\n76\t  const worseStreak = useRef(0);\n77\t\n78\t  const setMode = (on: boolean) => {\n79\t    setAuto(on);\n80\t    setGuardTrip(null);\n81\t    worseStreak.current = 0;\n82\t    try {\n83\t      localStorage.setItem(`loop-auto:${id}`, on ? \"1\" : \"0\");\n84\t    } catch {\n85\t      /* ignore */\n86\t    }\n87\t  };\n88\t\n89\t  const status = state.data?.overall_status;\n90\t  const findingsCount = state.data?.findings.length ?? 0;\n91\t\n92\t  // Direction guard: two consecutive refreshes with more findings => stop.\n93\t  useEffect(() => {\n94\t    if (!state.data) return;\n95\t    const prev = prevFindings.current;\n96\t    if (prev != null && findingsCount > prev) {\n97\t      worseStreak.current += 1;\n98\t      if (worseStreak.current >= 2 && auto) {\n99\t        setMode(false);\n100\t        setGuardTrip(\n101\t          \"Findings grew on two refreshes in a row — auto-loop paused. Check the direction before resuming.\",\n102\t        );\n103\t      }\n104\t    } else if (prev != null) {\n105\t      worseStreak.current = 0;\n106\t    }\n107\t    prevFindings.current = findingsCount;\n108\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n109\t  }, [state.dataUpdatedAt]);\n110\t\n111\t  // The loop.\n112\t  useEffect(() => {\n113\t    if (!auto || !id || !status) return;\n114\t    if (isTerminal(status)) {\n115\t      setMode(false);\n116\t      return;\n117\t    }\n118\t    const t = setInterval(() => {\n119\t      if (!refresh.isPending && !complete.isPending) refresh.mutate();\n120\t    }, LOOP_MS);\n121\t    return () => clearInterval(t);\n122\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n123\t  }, [auto, id, status, refresh.isPending, complete.isPending]);\n124\t\n125\t  return (\n126\t    <Async query={state}>\n127\t      {(s) => (\n128\t        <>\n129\t          <PageHead\n130\t            title={\n131\t              <span className=\"row\" style={{ gap: 10 }}>\n132\t                <span className=\"mono\">{s.task.id}</span>\n133\t                <Badge tone={statusTone(s.overall_status)}>{statusLabel(s.overall_status)}</Badge>\n134\t              </span>\n135\t            }\n136\t            subtitle={s.task.goal}\n137\t            actions={\n138\t              <>\n139\t                <Pressable\n140\t                  className={`btn${auto ? \" btn--primary\" : \"\"}`}\n141\t                  onClick={() => setMode(!auto)}\n142\t                  title=\"Auto: re-run refresh on an interval and keep the loop prompt current. Stops on READY / BLOCKED or if findings regress.\"\n143\t                >\n144\t                  <Icon name={auto ? \"refresh\" : \"target\"} size={14} />\n145\t                  Auto-loop {auto ? \"on\" : \"off\"}\n146\t                </Pressable>\n147\t                <Pressable\n148\t                  className=\"btn\"\n149\t                  disabled={busy}\n150\t                  onClick={() => refresh.mutate()}\n151\t                >\n152\t                  <RefreshGlyph spinning={refresh.isPending} />\n153\t                  Refresh\n154\t                </Pressable>\n155\t                <Pressable\n156\t                  className=\"btn btn--primary\"\n157\t                  disabled={busy}\n158\t                  onClick={() => complete.mutate()}\n159\t                  title=\"Runs a full re-check; only reports READY if the evidence supports it\"\n160\t                >\n161\t                  <Icon name=\"check\" size={14} />\n162\t                  Evaluate completion\n163\t                </Pressable>\n164\t              </>\n165\t            }\n166\t          />\n167\t\n168\t          <StatusBanner s={s} />\n169\t\n170\t          <LoopPrompt s={s} auto={auto} guardTrip={guardTrip} refreshing={refresh.isPending} />\n171\t\n172\t          <div className=\"grid grid--4\" style={{ marginTop: 4 }}>\n173\t            <StatTile\n174\t              label=\"Requirements\"\n175\t              value={`${s.requirements.filter((r) => r.status === \"COMPLETE\").length} / ${s.requirements.length}`}\n176\t              icon=\"target\"\n177\t            />\n178\t            <StatTile\n179\t              label=\"Tests\"\n180\t              value={s.tests.status === \"NOT_RUN\" ? \"—\" : `${s.tests.passed} pass`}\n181\t              sub={\n182\t                s.tests.status === \"NOT_RUN\"\n183\t                  ? \"not run\"\n184\t                  : `${s.tests.failed} failed · ${statusLabel(s.tests.status)}`\n185\t              }\n186\t              tone={statusTone(s.tests.status)}\n187\t              icon=\"check\"\n188\t            />\n189\t            <StatTile\n190\t              label=\"Working tree\"\n191\t              value={s.git.working_tree_clean ? \"clean\" : \"dirty\"}\n192\t              sub={`${s.git.files_changed} files  +${s.git.lines_added}/-${s.git.lines_deleted}`}\n193\t              tone={s.git.working_tree_clean ? \"ok\" : \"warn\"}\n194\t              icon=\"commit\"\n195\t            />\n196\t            <StatTile\n197\t              label=\"Impact\"\n198\t              value={s.impact.available ? `${s.impact.affected_files} files` : \"—\"}\n199\t              sub={s.impact.available ? `${s.impact.affected_tests} tests` : (s.impact.reason ?? \"\")}\n200\t              icon=\"layers\"\n201\t            />\n202\t          </div>\n203\t\n204\t          <div className=\"grid grid--2\" style={{ alignItems: \"start\", marginTop: 16 }}>\n205\t            <div className=\"stack\">\n206\t              <Card title=\"Requirements\" pad>\n207\t                {s.requirements.length === 0 && <p className=\"muted\">No requirements.</p>}\n208\t                <div className=\"stack\" style={{ gap: 10 }}>\n209\t                  {s.requirements.map((r) => (\n\n... [382 lines truncated] ..."},"type":"attachment","uuid":"bd736ffd-948b-4c40-bc7a-323f2fa6694f","timestamp":"2026-09-07T14:33:11.925Z","rendered":[{"content":"<system-reminder>\nNote: D:\\Hackathons\\TechWeek\\src\\devmemory\\web\\frontend\\src\\routes\\TaskDetail.tsx changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n1\timport { useEffect, useRef, useState } from \"react\";\n2\timport { useParams } from \"react-router-dom\";\n3\timport { useMutation, useQueryClient } from \"@tanstack/react-query\";\n4\timport {\n5\t  useTaskState,\n6\t  useTaskSnapshots,\n7\t  refreshTask,\n8\t  completeTask,\n9\t  reportIssue,\n10\t  resolveIssue,\n11\t  setRequirement,\n12\t} from \"@/api/client\";\n13\timport { Async } from \"@/components/Async\";\n14\timport { Badge, Card, PageHead, StatTile } from \"@/components/primitives\";\n15\timport { Icon } from \"@/components/Icon\";\n16\timport { statusTone, statusLabel, type Tone } from \"@/lib/status\";\n17\timport { shortSha, relativeTime } from \"@/lib/format\";\n18\timport {\n19\t  motion,\n20\t  AnimatePresence,\n21\t  useReducedMotion,\n22\t  spring,\n23\t  Pressable,\n24\t  DrawCheck,\n25\t} from \"@/lib/motion\";\n26\timport type { NormalizedState, RequirementStatus, SnapshotSummary } from \"@/api/types\";\n27\t\n28\tconst REQ_CYCLE: RequirementStatus[] = [\"INCOMPLETE\", \"PARTIAL\", \"COMPLETE\"];\n29\t\n30\texport function TaskDetail() {\n31\t  const { id } = useParams<{ id: string }>();\n32\t  const qc = useQueryClient();\n33\t  const state = useTaskState(id);\n34\t  const snapshots = useTaskSnapshots(id);\n35\t\n36\t  const apply = (data: NormalizedState) => {\n37\t    qc.setQueryData([\"task-state\", id], data);\n38\t    qc.invalidateQueries({ queryKey: [\"task-snapshots\", id] });\n39\t    qc.invalidateQueries({ queryKey: [\"tasks\"] });\n40\t  };\n41\t\n42\t  const refresh = useMutation({ mutationFn: () => refreshTask(id!), onSuccess: apply });\n43\t  const complete = useMutation({ mutationFn: () => completeTask(id!), onSuccess: apply });\n44\t  const setReq = useMutation({\n45\t    mutationFn: (v: { req: string; status: string }) => setRequirement(id!, v.req, v.status, \"set from dashboard\"),\n46\t    onSuccess: apply,\n47\t  });\n48\t  const addIssue = useMutation({\n49\t    mutationFn: (v: { description: string; blocking: boolean }) => reportIssue(id!, v.description, v.blocking),\n50\t    onSuccess: apply,\n51\t  });\n52\t  const dropIssue = useMutation({\n53\t    mutationFn: (issueId: number) => resolveIssue(id!, issueId),\n54\t    onSuccess: apply,\n55\t  });\n56\t\n57\t  const busy =\n58\t    refresh.isPending ||\n59\t    complete.isPending ||\n60\t    setReq.isPending ||\n61\t    addIssue.isPending ||\n62\t    dropIssue.isPending;\n63\t\n64\t  // --- auto-loop: keep refreshing and suggesting the next prompt -----------\n65\t  const LOOP_MS = 9000;\n66\t  const isTerminal = (st?: string) => st === \"READY\" || st === \"BLOCKED\";\n67\t  const [auto, setAuto] = useState(() => {\n68\t    try {\n69\t      return localStorage.getItem(`loop-auto:${id}`) === \"1\";\n70\t    } catch {\n71\t      return false;\n72\t    }\n73\t  });\n74\t  const [guardTrip, setGuardTrip] = useState<string | null>(null);\n75\t  const prevFindings = useRef<number | null>(null);\n76\t  const worseStreak = useRef(0);\n77\t\n78\t  const setMode = (on: boolean) => {\n79\t    setAuto(on);\n80\t    setGuardTrip(null);\n81\t    worseStreak.current = 0;\n82\t    try {\n83\t      localStorage.setItem(`loop-auto:${id}`, on ? \"1\" : \"0\");\n84\t    } catch {\n85\t      /* ignore */\n86\t    }\n87\t  };\n88\t\n89\t  const status = state.data?.overall_status;\n90\t  const findingsCount = state.data?.findings.length ?? 0;\n91\t\n92\t  // Direction guard: two consecutive refreshes with more findings => stop.\n93\t  useEffect(() => {\n94\t    if (!state.data) return;\n95\t    const prev = prevFindings.current;\n96\t    if (prev != null && findingsCount > prev) {\n97\t      worseStreak.current += 1;\n98\t      if (worseStreak.current >= 2 && auto) {\n99\t        setMode(false);\n100\t        setGuardTrip(\n101\t          \"Findings grew on two refreshes in a row — auto-loop paused. Check the direction before resuming.\",\n102\t        );\n103\t      }\n104\t    } else if (prev != null) {\n105\t      worseStreak.current = 0;\n106\t    }\n107\t    prevFindings.current = findingsCount;\n108\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n109\t  }, [state.dataUpdatedAt]);\n110\t\n111\t  // The loop.\n112\t  useEffect(() => {\n113\t    if (!auto || !id || !status) return;\n114\t    if (isTerminal(status)) {\n115\t      setMode(false);\n116\t      return;\n117\t    }\n118\t    const t = setInterval(() => {\n119\t      if (!refresh.isPending && !complete.isPending) refresh.mutate();\n120\t    }, LOOP_MS);\n121\t    return () => clearInterval(t);\n122\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n123\t  }, [auto, id, status, refresh.isPending, complete.isPending]);\n124\t\n125\t  return (\n126\t    <Async query={state}>\n127\t      {(s) => (\n128\t        <>\n129\t          <PageHead\n130\t            title={\n131\t              <span className=\"row\" style={{ gap: 10 }}>\n132\t                <span className=\"mono\">{s.task.id}</span>\n133\t                <Badge tone={statusTone(s.overall_status)}>{statusLabel(s.overall_status)}</Badge>\n134\t              </span>\n135\t            }\n136\t            subtitle={s.task.goal}\n137\t            actions={\n138\t              <>\n139\t                <Pressable\n140\t                  className={`btn${auto ? \" btn--primary\" : \"\"}`}\n141\t                  onClick={() => setMode(!auto)}\n142\t                  title=\"Auto: re-run refresh on an interval and keep the loop prompt current. Stops on READY / BLOCKED or if findings regress.\"\n143\t                >\n144\t                  <Icon name={auto ? \"refresh\" : \"target\"} size={14} />\n145\t                  Auto-loop {auto ? \"on\" : \"off\"}\n146\t                </Pressable>\n147\t                <Pressable\n148\t                  className=\"btn\"\n149\t                  disabled={busy}\n150\t                  onClick={() => refresh.mutate()}\n151\t                >\n152\t                  <RefreshGlyph spinning={refresh.isPending} />\n153\t                  Refresh\n154\t                </Pressable>\n155\t                <Pressable\n156\t                  className=\"btn btn--primary\"\n157\t                  disabled={busy}\n158\t                  onClick={() => complete.mutate()}\n159\t                  title=\"Runs a full re-check; only reports READY if the evidence supports it\"\n160\t                >\n161\t                  <Icon name=\"check\" size={14} />\n162\t                  Evaluate completion\n163\t                </Pressable>\n164\t              </>\n165\t            }\n166\t          />\n167\t\n168\t          <StatusBanner s={s} />\n169\t\n170\t          <LoopPrompt s={s} auto={auto} guardTrip={guardTrip} refreshing={refresh.isPending} />\n171\t\n172\t          <div className=\"grid grid--4\" style={{ marginTop: 4 }}>\n173\t            <StatTile\n174\t              label=\"Requirements\"\n175\t              value={`${s.requirements.filter((r) => r.status === \"COMPLETE\").length} / ${s.requirements.length}`}\n176\t              icon=\"target\"\n177\t            />\n178\t            <StatTile\n179\t              label=\"Tests\"\n180\t              value={s.tests.status === \"NOT_RUN\" ? \"—\" : `${s.tests.passed} pass`}\n181\t              sub={\n182\t                s.tests.status === \"NOT_RUN\"\n183\t                  ? \"not run\"\n184\t                  : `${s.tests.failed} failed · ${statusLabel(s.tests.status)}`\n185\t              }\n186\t              tone={statusTone(s.tests.status)}\n187\t              icon=\"check\"\n188\t            />\n189\t            <StatTile\n190\t              label=\"Working tree\"\n191\t              value={s.git.working_tree_clean ? \"clean\" : \"dirty\"}\n192\t              sub={`${s.git.files_changed} files  +${s.git.lines_added}/-${s.git.lines_deleted}`}\n193\t              tone={s.git.working_tree_clean ? \"ok\" : \"warn\"}\n194\t              icon=\"commit\"\n195\t            />\n196\t            <StatTile\n197\t              label=\"Impact\"\n198\t              value={s.impact.available ? `${s.impact.affected_files} files` : \"—\"}\n199\t              sub={s.impact.available ? `${s.impact.affected_tests} tests` : (s.impact.reason ?? \"\")}\n200\t              icon=\"layers\"\n201\t            />\n202\t          </div>\n203\t\n204\t          <div className=\"grid grid--2\" style={{ alignItems: \"start\", marginTop: 16 }}>\n205\t            <div className=\"stack\">\n206\t              <Card title=\"Requirements\" pad>\n207\t                {s.requirements.length === 0 && <p cl