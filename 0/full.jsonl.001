{"parentUuid":"f6a0be39-c83b-4eba-8056-9193384f9581","isSidechain":false,"promptId":"7880d82c-265a-4bca-a786-f6cb7147359f","type":"user","message":{"role":"user","content":[{"type":"text","text":"Databricks credentials are not set (DATABRICKS_HOST / DATABRICKS_TOKEN)\n\nSet a Genie space that reads the devmemory.analytics schema, then point DevMemory at it:\n\n# .devmemory/config.json\n\"databricks\": { \"enabled\": true, \"genie_space_id\": \"01ef...\" }\n\n# or the environment\nDATABRICKS_HOST=...       DATABRICKS_TOKEN=...\nDATABRICKS_GENIE_SPACE_ID=01ef...\n\n\n\nin the web dashboard this error came"}]},"uuid":"2c533313-5d8d-448a-8878-7b7d364d2239","timestamp":"2026-09-06T10:28:52.691Z","permissionMode":"auto","origin":{"kind":"human"},"promptSource":"sdk","userType":"external","entrypoint":"claude-vscode","cwd":"d:\\Hackathons\\TechWeek","sessionId":"fcec3b82-fe78-4cb6-b1dc-40e4f8a72893","version":"2.1.263","gitBranch":"docs/project-details","slug":"buzzing-baking-crystal"}
